includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - database
        - tests
    checkModelProperties: true
    # Models declare casts in a casts() method; without this Larastan reads only its `array`
    # return type and treats every cast column (dates, enums) as its raw database type.
    parseModelCastsMethod: true
    checkOctaneCompatibility: false
