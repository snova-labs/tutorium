# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=en

# Display name only. The codebase carries no product name (see README).
PLATFORM_NAME="Tutorium"
# cloud | self_hosted
PLATFORM_MODE=cloud

# ── Database ───────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=platform
DB_USERNAME=platform
DB_PASSWORD=secret

# ── Cost-aware defaults (SL-ARC-002 §11) ───────────────────────────────────────
# These run the whole product on one small server. Each has a documented upgrade
# path that changes configuration only, never application code.
QUEUE_CONNECTION=database        # → redis when a sustained backlog appears
CACHE_STORE=database             # → redis under concurrency
SESSION_DRIVER=database
FILESYSTEM_DISK=local            # → s3 when multiple app hosts or lifecycle rules are needed
PDF_RENDERER=php                 # → chrome when the report layout needs modern CSS

# ── Mail ───────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="${PLATFORM_NAME}"

# ── Object storage (Silo, a MinIO fork, in development) ────────────────────────
AWS_ACCESS_KEY_ID=platform
AWS_SECRET_ACCESS_KEY=platform-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=platform
AWS_ENDPOINT=http://silo:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Optional services (docker compose profiles) ────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Billing (P3) ───────────────────────────────────────────────────────────────
BILLING_PROVIDER=manual          # manual | stripe | mor
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
