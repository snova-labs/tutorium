# ── Tutorium production: a second stack from the same file, with these variables ─────────────────
# Same keys as staging; only the values change. Never copy staging's APP_KEY, database or token.

APP_SLUG=tutorium
# Moved only by the "Promote to production" workflow, to an image already proven on staging.
IMAGE_TAG=production

# Ingress, as in staging: keep these two lines for a Cloudflare Tunnel, or delete them and add
# proxy hosts in Nginx Proxy Manager (network PROXY_NETWORK, default web).
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

APP_NAME=Tutorium
PLATFORM_NAME=Tutorium
APP_ENV=production
APP_DEBUG=false
APP_KEY=CHANGE_ME
APP_URL=https://tutorium-api.jayshyampatel.com.np
WEB_URL=https://tutorium.jayshyampatel.com.np
APP_TIMEZONE=UTC
LOG_LEVEL=warning

# ~/scripts/my-create-db.sh tutorium
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tutorium
DB_USERNAME=tutorium
DB_PASSWORD=CHANGE_ME

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local
PDF_RENDERER=php

# Real mail in production: sign-in codes must reach people.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
# Blank for STARTTLS on 587; smtps for implicit TLS on 465.
MAIL_SCHEME=
MAIL_FROM_ADDRESS=no-reply@jayshyampatel.com.np
MAIL_FROM_NAME=Tutorium

BILLING_PROVIDER=manual

# Public signup stays closed until pricing and the payment route are decided (SL-901, SL-902).
SIGNUP_OPEN=false

# Backups (docs/DEPLOYMENT.md "Backups"). The drill restores last night's backup into this database
# every Sunday and checks it; create it once and grant tutorium access to it.
BACKUP_DRILL_DATABASE=tutorium_drill
# Who is emailed when a backup or a drill fails. Empty: every active operator.
BACKUP_ALERT_TO=
