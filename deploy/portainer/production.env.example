# ── Sajilo production: a second stack from the same file, with these variables ───────────────────
# Same keys as staging; only the values change. Never copy staging's APP_KEY, database or token.

APP_SLUG=sajilo
# Moved only by the "Promote to production" workflow, to an image already proven on staging.
IMAGE_TAG=production

# Ingress, as in staging: keep these two lines for a Cloudflare Tunnel, or delete them and add
# proxy hosts in Nginx Proxy Manager (network PROXY_NETWORK, default web).
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

APP_NAME=Sajilo
PLATFORM_NAME=Sajilo
APP_ENV=production
APP_DEBUG=false
APP_KEY=CHANGE_ME
APP_URL=https://sajilo-api.jayshyampatel.com.np
WEB_URL=https://sajilo.jayshyampatel.com.np
APP_TIMEZONE=UTC
LOG_LEVEL=warning

# ~/scripts/my-create-db.sh sajilo
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sajilo
DB_USERNAME=sajilo
DB_PASSWORD=CHANGE_ME

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local
PDF_RENDERER=php

# Real mail in production: sign-in codes must reach people.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
# Blank for STARTTLS on 587; smtps for implicit TLS on 465.
MAIL_SCHEME=
MAIL_FROM_ADDRESS=no-reply@jayshyampatel.com.np
MAIL_FROM_NAME=Sajilo

BILLING_PROVIDER=manual

# Public signup stays closed until pricing and the payment route are decided (SL-901, SL-902).
SIGNUP_OPEN=false
