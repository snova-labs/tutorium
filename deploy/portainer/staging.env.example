# ── Sajilo staging: Portainer → Stacks → sajilo-staging → Environment variables ───────────────────
# Substituted into deploy/portainer/sajilo.stack.yml. Keep a copy of the secrets (APP_KEY,
# DB_PASSWORD, CLOUDFLARE_TUNNEL_TOKEN) in your password manager.

# Which environment this stack is. Every container, network and volume name starts with it.
APP_SLUG=sajilo-staging
# Image tag: CI moves "staging" on every green build of main.
IMAGE_TAG=staging

# From Cloudflare Zero Trust → Networks → Tunnels → sajilo-staging → the token in the install command.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# ── Laravel ──
APP_NAME=Sajilo
PLATFORM_NAME=Sajilo (staging)
APP_ENV=staging
APP_DEBUG=false
# Generate once on the server: echo "base64:$(openssl rand -base64 32)"
# Never change it afterwards (it decrypts stored secrets and signs sessions).
APP_KEY=CHANGE_ME
APP_URL=https://sajilo-staging-api.jayshyampatel.com.np
APP_TIMEZONE=UTC
# debug: the log mailer writes mail at debug level, so anything higher hides the sign-in codes.
LOG_LEVEL=debug

# The shared MySQL stack. Create with: ~/scripts/my-create-db.sh sajilo_staging
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sajilo_staging
DB_USERNAME=sajilo_staging
DB_PASSWORD=CHANGE_ME

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local
PDF_RENDERER=php

# Staging writes mail to the log instead of sending it, so sign-in codes appear in
# Portainer → Containers → sajilo-staging-api → Logs. Switch to smtp to send real mail.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@jayshyampatel.com.np
MAIL_FROM_NAME=Sajilo (staging)

# manual = invoicing only, no card provider. Use fake to try the card flows without Stripe.
BILLING_PROVIDER=manual
