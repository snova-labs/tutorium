# ── Tutorium staging: Portainer → Stacks → tutorium-staging → Environment variables ───────────────
# Substituted into deploy/portainer/stack.yml. Keep a copy of the secrets (APP_KEY,
# DB_PASSWORD, CLOUDFLARE_TUNNEL_TOKEN) in your password manager.

# Which environment this stack is. Every container, network and volume name starts with it.
APP_SLUG=tutorium-staging
# No IMAGE_TAG here: Deploy to staging pins the exact image (sha-…) in the staging branch's copy of
# the stack file, and the stack follows that branch.

# ── How traffic gets in: keep ONE of the two blocks ──
# A) Cloudflare Tunnel, with Cloudflare Access in front (staging's default).
#    The token is in Zero Trust → Networks → Tunnels → tutorium-staging → the install command.
# "mailpit" adds the staging mail inbox (docs/DEPLOYMENT.md "Mailpit: the staging inbox").
COMPOSE_PROFILES=tunnel,mailpit
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME
# B) Nginx Proxy Manager: delete CLOUDFLARE_TUNNEL_TOKEN and keep only the inbox profile,
#    COMPOSE_PROFILES=mailpit. app, web and mailpit join NPM's network:
# PROXY_NETWORK=web

# ── Laravel ──
APP_NAME=Tutorium
PLATFORM_NAME=Tutorium (staging)
APP_ENV=staging
APP_DEBUG=false
# Generate once on the server: echo "base64:$(openssl rand -base64 32)"
# Never change it afterwards (it decrypts stored secrets and signs sessions).
APP_KEY=CHANGE_ME
APP_URL=https://tutorium-staging-api.jayshyampatel.com.np
WEB_URL=https://tutorium-staging.jayshyampatel.com.np
APP_TIMEZONE=UTC
# debug: the log mailer writes mail at debug level, so anything higher hides the sign-in codes.
LOG_LEVEL=debug

# The shared MySQL stack. Create with: ~/scripts/my-create-db.sh tutorium_staging
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tutorium_staging
DB_USERNAME=tutorium_staging
DB_PASSWORD=CHANGE_ME

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local
PDF_RENDERER=php

# Staging sends every email to its own Mailpit (the "mailpit" profile above): nothing reaches a real
# inbox, and you read them at the inbox address. Without Mailpit, use MAIL_MAILER=log and read them
# in the API container's logs.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional password on the inbox ("user:password"). Leave empty when Cloudflare Access protects it.
MAILPIT_UI_AUTH=
MAIL_FROM_ADDRESS=no-reply@jayshyampatel.com.np
MAIL_FROM_NAME=Tutorium (staging)

# manual = invoicing only, no card provider. Use fake to try the card flows without Stripe.
BILLING_PROVIDER=manual

# Public signup at WEB_URL/sign-up. The confirmation email lands in Mailpit.
SIGNUP_OPEN=true

# Backups (docs/DEPLOYMENT.md "Backups"). The drill restores last night's backup into this database
# every Sunday and checks it; create it once and grant tutorium_staging access to it.
BACKUP_DRILL_DATABASE=tutorium_staging_drill
# Who is emailed when a backup or a drill fails. Empty: every active operator.
BACKUP_ALERT_TO=

# Demo academies: open WEB_URL/demo, enter this password, press Load (and Remove when you are done).
# It is also every demo account's password. Leave it empty to switch the page off.
DEMO_PASSWORD=CHANGE_ME
